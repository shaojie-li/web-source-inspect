{
  "manifest_version": 3,
  "name": "React Trace",
  "version": "0.0.1",
  "description": "Alt-click a page element to map it to source code with source maps and open it in your editor",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content.js"],
      "world": "MAIN",
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
